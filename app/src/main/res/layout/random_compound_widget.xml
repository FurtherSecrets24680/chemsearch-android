<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_random_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_random_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="44dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_random_formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="44dp"
            android:textColor="#BDC1C6"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_random_uses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="44dp"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_random_refresh"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:background="@drawable/widget_refresh_background"
        android:src="@drawable/ic_widget_refresh"
        android:contentDescription="@string/ui_widget_random_refresh" />

    <TextView
        android:id="@+id/widget_random_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        android:text="@string/ui_widget_random_tap_refresh"
        android:textColor="#5F6368"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
</FrameLayout>
